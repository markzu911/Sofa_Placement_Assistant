{
  "version": 2,
  "functions": {
    "app/api/generate/route.js": {
      "maxDuration": 120
    },
    "app/api/launch/route.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/ai-tool/:toolId/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/ai-tool/:toolId/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
